    "This template has no photo areas yet supported by the editor. Text and sticker editing arrive in an upcoming update." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا القالب على مناطق صور يدعمها المحرّر بعد. سيأتي تحرير النصوص والملصقات في تحديث قادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
