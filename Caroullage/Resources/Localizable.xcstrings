    "%@ once. Not a subscription — pay once and keep Caroullage Premium forever." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ مرة واحدة. ليس اشتراكًا — ادفع مرة واحدة واحتفظ بـ Caroullage Premium للأبد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ einmalig. Kein Abo – einmal zahlen und Caroullage Premium für immer behalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ once. Not a subscription — pay once and keep Caroullage Premium forever."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ una vez. No es una suscripción: pagas una vez y Caroullage Premium es tuyo para siempre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ une fois. Ce n'est pas un abonnement : payez une fois et gardez Caroullage Premium à vie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ एक बार। यह सब्सक्रिप्शन नहीं है — एक बार भुगतान करें और Caroullage Premium हमेशा के लिए रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ una tantum. Non è un abbonamento: paghi una volta e Caroullage Premium è tuo per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の一回払い。サブスクではありません。一度支払えば Caroullage Premium はずっと使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 1회 결제. 구독이 아니며, 한 번 결제하면 Caroullage 프리미엄을 계속 사용할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ uma vez. Não é assinatura: pague uma vez e fique com o Caroullage Premium para sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次性 %@。不是订阅：付一次，Caroullage Premium 永久归你。"
          }
        }
      }
    },
    "%@ per month. Renews automatically until cancelled. Cancel anytime in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ شهريًا. يتجدّد تلقائيًا حتى تلغيه. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Monat. Verlängert sich automatisch bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ per month. Renews automatically until cancelled. Cancel anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al mes. Se renueva automáticamente hasta que la canceles. Cancela cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ par mois. Renouvellement automatique jusqu'à annulation. Annulez quand vous voulez dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ प्रति माह। रद्द करने तक अपने आप नवीनीकृत होता है। सेटिंग में कभी भी रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al mese. Si rinnova automaticamente fino alla disdetta. Disdici quando vuoi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月額 %@。解約するまで自動更新されます。設定からいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "월 %@. 해지할 때까지 자동 갱신됩니다. 설정에서 언제든 해지할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ por mês. Renova automaticamente até você cancelar. Cancele quando quiser em Ajustes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月 %@。在取消前将自动续订。可随时在“设置”中取消。"
