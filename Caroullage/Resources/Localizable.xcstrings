            "value": "%@ rimasti · risoluzione piena, 4K e HEVC, senza filigrana"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بقي %@ · دقة كاملة، 4K و HEVC، بلا علامة مائية"
