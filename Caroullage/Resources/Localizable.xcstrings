          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sugerencias necesitan permiso para leer tus fotos recientes. Puedes activarlo en Ajustes; todo lo demás sigue funcionando sin él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suggestions ont besoin de l'autorisation de lire vos photos récentes. Vous pouvez l'activer dans Réglages — tout le reste fonctionne sans."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुझावों के लिए आपकी हाल की फ़ोटो पढ़ने की अनुमति चाहिए। इसे सेटिंग्स में चालू कर सकते हैं — बाकी सब इसके बिना भी काम करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suggerimenti richiedono il permesso di leggere le tue foto recenti. Puoi attivarlo nelle Impostazioni: tutto il resto funziona anche senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
