    "Caroullage reads your recent photos to show you a collage of your own instead of a stock one. Nothing leaves your phone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Caroullage صورك الأخيرة ليعرض مجمّعًا من صورك أنت، لا صورًا جاهزة. ولا يغادر شيء هاتفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage liest deine letzten Fotos und zeigt dir eine eigene Collage statt einer Stockvorlage. Nichts verlässt dein Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage reads your recent photos to show you a collage of your own instead of a stock one. Nothing leaves your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage lee tus fotos recientes para enseñarte un collage tuyo, no uno de archivo. Nada sale de tu móvil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage lit vos photos récentes pour vous montrer un collage à vous, pas une image d'archive. Rien ne quitte votre téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage आपकी हाल की फ़ोटो पढ़कर स्टॉक नहीं, आपका अपना कोलाज दिखाता है। कुछ भी फ़ोन से बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage legge le tue foto recenti per mostrarti un collage tuo, non di repertorio. Nulla lascia il telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage は最近の写真を読み込み、ストック画像ではなくあなた自身のコラージュを表示します。データは端末から出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage는 최근 사진을 읽어 스톡 이미지 대신 내 사진으로 만든 콜라주를 보여줍니다. 어떤 것도 기기를 벗어나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Caroullage lê suas fotos recentes para mostrar uma colagem sua, não de banco de imagens. Nada sai do seu celular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caroullage 读取你最近的照片，展示属于你的拼贴，而不是素材图。所有内容都留在手机上。"
          }
        }
      }
    },
