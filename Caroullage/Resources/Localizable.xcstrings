    "No previous purchase found on this Apple Account.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على عملية شراء سابقة في حساب Apple هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Apple-Konto wurde kein früherer Kauf gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No previous purchase found on this Apple Account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna compra anterior en esta cuenta de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat antérieur trouvé sur ce compte Apple."
          }
