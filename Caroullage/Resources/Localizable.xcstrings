    "Drop photos into a grid or a shape and it arranges itself around them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفلِت صورك في شبكة أو شكل، ويرتّب نفسه حولها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos in ein Raster oder eine Form ziehen – der Rest ordnet sich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop photos into a grid or a shape and it arranges itself around them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suelta fotos en una cuadrícula o una forma y todo se ordena solo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déposez vos photos dans une grille ou une forme : tout s'ajuste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ग्रिड या आकार में फ़ोटो डालें, बाकी सब अपने आप सज जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina le foto in una griglia o in una forma: si sistema da sé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "グリッドや図形に写真を置くだけで、まわりが自動で整います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그리드나 도형에 사진을 놓으면 나머지는 알아서 정리돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte fotos em uma grade ou forma e tudo se organiza sozinho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把照片放进网格或形状里，其余部分会自动排好。"
