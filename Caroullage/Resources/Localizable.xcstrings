    "Mix clips and photos, cut to the beat, and lift a subject out of its background." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امزج المقاطع والصور، وقُصّ على الإيقاع، وافصل العنصر عن خلفيته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clips und Fotos mischen, im Takt schneiden, Motive freistellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mix clips and photos, cut to the beat, and lift a subject out of its background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mezcla clips y fotos, corta al ritmo y recorta el sujeto del fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mélangez clips et photos, calez sur le rythme, détourez un sujet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्लिप और फ़ोटो मिलाएँ, बीट पर काटें, और विषय को बैकग्राउंड से अलग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unisci clip e foto, taglia a tempo ed estrai il soggetto dallo sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画と写真を混ぜ、ビートに合わせて切り、被写体を背景から抜けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상과 사진을 섞고, 비트에 맞춰 자르고, 피사체만 배경에서 분리하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misture clipes e fotos, corte no ritmo e recorte o objeto do fundo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混剪视频与照片，卡着节拍切换，还能把主体从背景中抠出来。"
          }
        }
      }
    },
