    "%lld days free, then %@ per year. Renews automatically until cancelled. Cancel anytime in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld أيام مجانًا، ثم %2$@ سنويًا. يتجدّد تلقائيًا حتى تلغيه. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Tage gratis, danach %2$@ pro Jahr. Verlängert sich automatisch bis zur Kündigung. Jederzeit in den Einstellungen kündbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld days free, then %@ per year. Renews automatically until cancelled. Cancel anytime in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld días gratis y después %2$@ al año. Se renueva automáticamente hasta que la canceles. Cancela cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld jours gratuits, puis %2$@ par an. Renouvellement automatique jusqu'à annulation. Annulez quand vous voulez dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld दिन मुफ़्त, फिर %2$@ प्रति वर्ष। रद्द करने तक अपने आप नवीनीकृत होता है। सेटिंग में कभी भी रद्द करें।"
          }
