    "Suggestions need permission to read your recent photos. You can turn it on in Settings — everything else keeps working without it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج الاقتراحات إلى إذن لقراءة صورك الأخيرة. يمكنك تفعيله من الإعدادات — وكل شيء آخر يعمل بدونه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorschläge brauchen die Erlaubnis, deine neuesten Fotos zu lesen. Du kannst sie in den Einstellungen erteilen — alles andere funktioniert auch ohne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
