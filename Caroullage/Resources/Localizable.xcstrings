      }
    },
    "Not subscribing? Buy a single credit and export this one at full quality.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا ترغب في الاشتراك؟ اشترِ رصيدًا واحدًا وصدّر هذا العمل بالجودة الكاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Abo? Kauf ein einzelnes Guthaben und exportiere dieses in voller Qualität."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not subscribing? Buy a single credit and export this one at full quality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No quieres suscribirte? Compra un crédito y exporta esta con calidad completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'abonnement ? Achetez un crédit et exportez celui-ci en pleine qualité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब्सक्राइब नहीं करना? एक क्रेडिट खरीदें और इसे पूरी क्वालिटी में एक्सपोर्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente abbonamento? Compra un credito ed esporta questo in qualità piena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクは不要ですか？ クレジットを1つ買えば、これをフル画質で書き出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 부담스럽나요? 크레딧 하나만 사면 이번 작업을 최고 품질로 내보낼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem assinatura? Compre um crédito e exporte esta em qualidade total."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不想订阅？买一个点数，就能以完整画质导出这一个。"
          }
        }
      }
    },
    "One credit exports one collage at full quality, with no watermark. Credits are not a subscription and stay on this device.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد واحد يصدّر مجمّعًا واحدًا بالجودة الكاملة وبلا علامة مائية. الأرصدة ليست اشتراكًا وتبقى على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Guthaben exportiert eine Collage in voller Qualität, ohne Wasserzeichen. Guthaben ist kein Abo und bleibt auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One credit exports one collage at full quality, with no watermark. Credits are not a subscription and stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un crédito exporta un collage con calidad completa y sin marca de agua. Los créditos no son una suscripción y se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un crédit exporte un collage en pleine qualité, sans filigrane. Les crédits ne sont pas un abonnement et restent sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक क्रेडिट से एक कोलाज पूरी क्वालिटी में, बिना वॉटरमार्क एक्सपोर्ट होता है। क्रेडिट सब्सक्रिप्शन नहीं हैं और इसी डिवाइस पर रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un credito esporta un collage in qualità piena, senza filigrana. I crediti non sono un abbonamento e restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1クレジットでコラージュを1つ、フル画質・透かしなしで書き出せます。クレジットはサブスクではなく、この端末に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레딧 1개로 콜라주 1개를 최고 품질·워터마크 없이 내보냅니다. 크레딧은 구독이 아니며 이 기기에만 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um crédito exporta uma colagem em qualidade total, sem marca d'água. Créditos não são assinatura e ficam neste aparelho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个点数可导出 1 个全画质、无水印的拼贴。点数不是订阅，且仅保存在本机。"
          }
        }
      }
    },
    "One picture cut across several posts, lined up so it flows as people swipe.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورة واحدة موزّعة على عدّة منشورات، مُحاذاة لتنساب مع التمرير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bild über mehrere Posts, so ausgerichtet, dass es beim Wischen fließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One picture cut across several posts, lined up so it flows as people swipe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen repartida en varias publicaciones, alineada para fluir al deslizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image répartie sur plusieurs posts, alignée pour couler au fil du swipe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक तस्वीर कई पोस्ट में बँटी, ऐसे सजी कि स्वाइप करते ही बहती लगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'immagine divisa su più post, allineata per scorrere con lo swipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1枚の写真を複数の投稿に分割し、スワイプでつながるように配置します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 한 장을 여러 게시물로 나눠, 넘길 때 자연스럽게 이어지도록 맞춰줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem dividida em vários posts, alinhada para fluir ao deslizar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把一张图切成多条帖子，滑动时能连贯衔接。"
          }
        }
      }
    },
