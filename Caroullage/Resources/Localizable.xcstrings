    "Your canvas is %@ but this preset prefers %@. It will export anyway, scaled to fill the frame." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحتك %1$@ لكن هذا الإعداد يفضّل %2$@. سيتم التصدير على أي حال مع التحجيم لملء الإطار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fläche ist %1$@, dieses Preset erwartet %2$@. Es wird trotzdem exportiert und formatfüllend skaliert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your canvas is %1$@ but this preset prefers %2$@. It will export anyway, scaled to fill the frame."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu lienzo es %1$@ pero este ajuste prefiere %2$@. Se exportará igualmente, escalado para llenar el marco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre toile est en %1$@ mais ce préréglage préfère %2$@. L'export se fera quand même, mis à l'échelle pour remplir le cadre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका कैनवास %1$@ है, पर यह प्रीसेट %2$@ पसंद करता है। फिर भी एक्सपोर्ट होगा, फ़्रेम भरने के लिए स्केल करके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua tela è %1$@ ma questo preset preferisce %2$@. Verrà esportata comunque, ridimensionata per riempire il fotogramma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンバスは %1$@ ですが、このプリセットは %2$@ を想定しています。フレームいっぱいに拡大して書き出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캔버스는 %1$@이지만 이 프리셋은 %2$@를 권장합니다. 프레임에 맞춰 확대해 그대로 내보냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua tela é %1$@, mas este preset prefere %2$@. A exportação vai acontecer mesmo assim, escalada para preencher o quadro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的画布是 %1$@，而此预设更适合 %2$@。仍会导出，并缩放以填满画面。"
          }
        }
      }
    },
