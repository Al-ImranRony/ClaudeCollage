    "No clear subject in this photo. Try one with a distinct person or object." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد عنصر واضح في هذه الصورة. جرّب صورة فيها شخص أو شيء بارز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein klares Motiv in diesem Foto. Probiere eines mit einer deutlichen Person oder einem Objekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No clear subject in this photo. Try one with a distinct person or object."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un sujeto claro en esta foto. Prueba con una que tenga una persona u objeto definido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun sujet net sur cette photo. Essayez-en une avec une personne ou un objet distinct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस फ़ोटो में कोई स्पष्ट विषय नहीं है। किसी अलग दिखते व्यक्ति या वस्तु वाली फ़ोटो आज़माएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun soggetto chiaro in questa foto. Provane una con una persona o un oggetto ben definiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この写真にははっきりした被写体がありません。人物や物がはっきり写った写真をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 사진에는 뚜렷한 피사체가 없습니다. 사람이나 사물이 분명한 사진으로 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há um assunto claro nesta foto. Tente uma com uma pessoa ou objeto bem definido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这张照片中没有清晰的主体，请换一张人物或物体明确的照片。"
          }
        }
      }
    },
    "Subject lifting needs a real device — it isn't available in the simulator." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب استخراج العنصر جهازًا حقيقيًا — غير متاح في المحاكي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freistellen braucht ein echtes Gerät — im Simulator ist es nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subject lifting needs a real device — it isn't available in the simulator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recortar el sujeto requiere un dispositivo real; no está disponible en el simulador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le détourage nécessite un vrai appareil — indisponible dans le simulateur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विषय अलग करने के लिए असली डिवाइस चाहिए — यह सिम्युलेटर में उपलब्ध नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
