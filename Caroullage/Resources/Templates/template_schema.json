{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devron.com/schemas/caroullage/template.json",
  "title": "Caroullage Standard Template",
  "description": "Schema for a single standard (non-carousel) collage template.",
  "type": "object",
  "required": ["id", "name", "category", "isPremium", "canvasAspectRatio", "cells", "background"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["story", "grid", "minimal", "seasonal", "travel", "moodboard", "birthday", "instant", "film", "editorial", "dump"]
    },
    "isPremium": { "type": "boolean" },
    "canvasAspectRatio": {
      "type": "string",
      "enum": ["1:1", "9:16", "4:5", "16:9", "A4"]
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cell" }
    },
    "background": { "$ref": "#/$defs/background" },
    "style": {
      "type": "object",
      "description": "Reference-point spacing, cornerRadius and outerMargin, plus 0-1 shadow and outlineWidth/outlineHex — what the editor's Spacing, Corners and Frame controls open at. With a style, cell frames tile the canvas edge to edge and the layout engine carves the gaps.",
      "properties": {
        "spacing": { "type": "number", "minimum": 0 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "outerMargin": { "type": "number", "minimum": 0 },
        "shadow": { "type": "number", "minimum": 0, "maximum": 1 },
        "outlineWidth": { "type": "number", "minimum": 0 },
        "outlineHex": { "type": "string" }
      }
    },
    "decorations": {
      "type": "array",
      "description": "Flat shapes painted between the background and the photos: instant-print cards, film bands and sprocket holes, tape.",
      "items": {
        "type": "object",
        "required": ["frame"],
        "properties": {
          "frame": { "type": "object" },
          "shape": { "type": "string", "enum": ["rectangle", "ellipse"] },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$" },
          "cornerRadius": { "type": "number", "minimum": 0, "description": "fraction of the canvas short side" },
          "shadow": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["id", "type", "frame", "shape"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["photo", "video", "text", "sticker", "decoration"] },
        "frame": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "minimum": 0, "maximum": 1 },
            "height": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "shape": {
          "type": "string",
          "enum": ["rectangle", "diagonal", "triangle", "hexagon", "circle", "oval", "custom"]
        },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 20 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "description": "text zones: the default caption/headline string" },
        "fontName": { "type": "string", "description": "text zones: PostScript font name, e.g. AvenirNext-Bold" },
        "fontSize": { "type": "number", "minimum": 1, "description": "text zones: point size on the reference canvas (short side 1080px)" },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "description": "text zones: fill colour" },
        "alignment": { "type": "string", "enum": ["leading", "center", "trailing", "justified"] },
        "stickerID": { "type": "string", "description": "sticker zones: bundled sticker id" }
      }
    },
    "background": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["solid", "gradient", "texture", "pattern", "photoBlur"] },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "colors": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "textureName": { "type": "string" }
      }
    }
  }
}
