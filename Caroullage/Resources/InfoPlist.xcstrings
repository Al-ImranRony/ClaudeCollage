    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Caroullage صورك الأخيرة ليقترح عليك مجمّعات مصنوعة منها. ولا يغادر شيء هاتفك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage liest deine letzten Fotos, um dir Collagen daraus vorzuschlagen. Nichts verlässt dein Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage reads your recent photos to suggest collages made from them. Nothing leaves your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage lee tus fotos recientes para sugerirte collages hechos con ellas. Nada sale de tu móvil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage lit vos photos récentes pour vous suggérer des collages créés avec elles. Rien ne quitte votre téléphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage आपकी हाल की फ़ोटो पढ़कर उन्हीं से बने कोलाज सुझाता है। कुछ भी फ़ोन से बाहर नहीं जाता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage legge le tue foto recenti per suggerirti collage creati con esse. Nulla lascia il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage は最近の写真を読み込み、それらを使ったコラージュを提案します。データは端末から出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caroullage는 최근 사진을 읽어 그 사진으로 만든 콜라주를 추천합니다. 어떤 것도 기기를 벗어나지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Caroullage lê suas fotos recentes para sugerir colagens feitas com elas. Nada sai do seu celular."
          }
        },
