{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devron.com/schemas/caroullage/carousel.json",
  "title": "Caroullage Carousel Template",
  "description": "Schema for a SCRL-style carousel template (2–10 linked frames).",
  "type": "object",
  "required": [
    "id", "name", "category", "isPremium", "carouselType",
    "canvasAspectRatio", "frameCount", "frames", "background"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "type": "string" },
    "isPremium": { "type": "boolean" },
    "carouselType": {
      "type": "string",
      "enum": ["panoramic", "matched", "scrollThrough", "gridPreview"]
    },
    "canvasAspectRatio": {
      "type": "string",
      "enum": ["1:1", "9:16", "4:5", "16:9"]
    },
    "frameCount": { "type": "integer", "minimum": 2, "maximum": 10 },
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["index", "cells"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "cells": {
            "type": "array",
            "items": { "$ref": "https://devron.com/schemas/caroullage/template.json#/$defs/cell" }
          }
        }
      }
    },
    "panoramicSource": {
      "type": "object",
      "properties": {
        "splitAxis": { "type": "string", "enum": ["horizontal", "vertical"] },
        "overlapPixels": { "type": "integer", "minimum": 0 }
      }
    },
    "background": { "$ref": "https://devron.com/schemas/caroullage/template.json#/$defs/background" }
  }
}
