{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devron.com/schemas/claudecollage/template.json",
  "title": "ClaudeCollage Standard Template",
  "description": "Schema for a single standard (non-carousel) collage template.",
  "type": "object",
  "required": ["id", "name", "category", "isPremium", "canvasAspectRatio", "cells", "background"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["story", "grid", "minimal", "seasonal", "travel", "moodboard", "birthday"]
    },
    "isPremium": { "type": "boolean" },
    "canvasAspectRatio": {
      "type": "string",
      "enum": ["1:1", "9:16", "4:5", "16:9", "A4"]
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/cell" }
    },
    "background": { "$ref": "#/$defs/background" }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["id", "type", "frame", "shape"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["photo", "video", "text", "sticker", "decoration"] },
        "frame": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "minimum": 0, "maximum": 1 },
            "height": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "shape": {
          "type": "string",
          "enum": ["rectangle", "diagonal", "triangle", "hexagon", "circle", "oval", "custom"]
        },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 20 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "defaultText": { "type": "string" },
        "fontStyle": { "type": "string" }
      }
    },
    "background": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["solid", "gradient", "texture"] },
        "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "colors": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
        },
        "textureName": { "type": "string" }
      }
    }
  }
}
