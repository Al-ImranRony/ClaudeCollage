// Release configuration — App Store production
#include? "Local.xcconfig"

ENVIRONMENT = production
API_BASE_URL = https:/$()/api.devron.com

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) RELEASE
SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
ONLY_ACTIVE_ARCH = NO
ENABLE_TESTABILITY = NO
VALIDATE_PRODUCT = YES

INFOPLIST_KEY_ENVIRONMENT = $(ENVIRONMENT)
INFOPLIST_KEY_API_BASE_URL = $(API_BASE_URL)
